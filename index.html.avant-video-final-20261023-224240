<script id="ohman-review-lightbox-script">
(() => {
  const box = document.getElementById('ohman-review-lightbox');
  if (!box) return;
  const big = box.querySelector('img');
  const close = () => {
    box.classList.remove('is-open');
    document.body.style.overflow = '';
  };
  document.querySelectorAll('.ohman-review-thumb').forEach(button => {
    button.addEventListener('click', () => {
      const image = button.querySelector('img');
      big.src = image.src;
      big.alt = image.alt;
      box.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  });
  box.addEventListener('click', close);
  box.querySelector('img').addEventListener('click', event => event.stopPropagation());
  box.querySelector('.ohman-review-close').addEventListener('click', close);
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') close();
  });
})();
</script>

