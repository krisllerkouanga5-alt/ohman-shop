:root{--o:#ff7a0a;--bg:#050505;--g:#b9b9b9;color-scheme:dark}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;background:var(--bg)}
body{font-family:Poppins,system-ui,sans-serif;color:#fff;background:var(--bg);overflow-x:hidden;padding-top:env(safe-area-inset-top,0)}
a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
svg.i{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.o{color:var(--o)}
.wrap{max-width:1280px;margin:auto;container-type:inline-size;position:relative}
header{position:fixed;inset:0 0 auto;z-index:20;transition:background .3s;padding-top:env(safe-area-inset-top,0)}
header.s{background:rgba(5,5,5,.9);backdrop-filter:blur(10px)}
.bar{display:flex;align-items:center;height:max(64px,7.8cqw);padding:0 6cqw}
.bar>a img{height:max(40px,5.4cqw);display:block}
nav{display:flex;gap:3.6cqw;margin-left:4.7cqw}
nav a{font-size:max(13px,1.3cqw);font-weight:500;position:relative;padding:.6cqw 0}
nav a::after{content:"";position:absolute;left:0;right:0;bottom:-.5cqw;height:2px;background:var(--o);transform:scaleX(0);transition:transform .25s}
nav a.on::after,nav a:hover::after{transform:scaleX(1)}
.rt{margin-left:auto;display:flex;align-items:center;gap:2.2cqw}
.ic{font-size:max(18px,1.9cqw);position:relative;display:grid;place-items:center}
.bd{position:absolute;top:-.9em;right:-.9em;background:var(--o);color:#000;font-size:max(9px,.85cqw);font-weight:700;border-radius:50%;width:1.7em;height:1.7em;display:grid;place-items:center}
.pill{background:var(--o);color:#1a0d00;font-weight:600;border-radius:99px;display:inline-flex;align-items:center;justify-content:center;gap:.6em;transition:transform .2s,box-shadow .2s}
.pill:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(255,122,10,.45)}
.pill.sm{font-size:max(12px,1.2cqw);padding:.9cqw 2.2cqw}
.bg{display:none;font-size:26px}
.hero{position:relative;aspect-ratio:1024/900;overflow:hidden;background:radial-gradient(60% 55% at 70% 25%,rgba(255,110,0,.28),transparent 70%),#050505}
.a{position:absolute}
.slash{left:30cqw;top:0;width:45cqw;height:78cqw;background:linear-gradient(160deg,rgba(255,110,0,.8),rgba(255,110,0,0) 55%);clip-path:polygon(60% 6%,92% 6%,22% 100%,0 100%);opacity:.55}
.head{mask-image:linear-gradient(90deg,transparent,#000 14%)}
.prod img{mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent),linear-gradient(180deg,transparent,#000 4%,#000 92%,transparent);mask-composite:intersect;-webkit-mask-composite:source-in;transition:transform .15s}
img{display:block;width:100%}
.txt{left:6.4cqw;top:14.4cqw;width:52cqw}
.eb{font-size:max(13px,1.72cqw);font-weight:600;color:var(--o);border-left:2px solid var(--o);padding-left:.4cqw;line-height:1}
.h1{font-size:max(60px,9.1cqw);font-weight:800;line-height:.9;margin-top:1.4cqw;letter-spacing:-.02em}
.h2{font-size:max(30px,5.25cqw);font-weight:700;line-height:1.03;letter-spacing:-.015em;margin-top:.4cqw}
.lead{font-size:max(14px,1.6cqw);line-height:1.27;width:33cqw;margin-top:2.6cqw}
.txt .pill{font-size:max(14px,1.4cqw);width:19.4cqw;height:4.5cqw;min-width:200px;margin-top:2.6cqw}
.trust{display:flex;margin-top:3.6cqw}
.trust div{padding:0 2.2cqw;border-right:1px solid #2c2c2c;text-align:center;font-size:max(11px,1.25cqw);line-height:1.3;color:var(--g)}
.trust div:first-child{padding-left:0;text-align:left}.trust div:last-child{border:0}
.trust svg{display:block;color:var(--o);font-size:max(18px,2cqw);margin:0 auto .6cqw}.trust div:first-child svg{margin-left:0}
.trust b{display:block;color:#fff;font-weight:500}
.card{display:flex;gap:1.2cqw;padding:1.5cqw 1.6cqw 2.2cqw;border:1px solid rgba(255,122,10,.5);border-radius:1.5cqw;background:linear-gradient(135deg,rgba(32,32,32,.78),rgba(8,8,8,.88));backdrop-filter:blur(6px);transition:transform .3s,border-color .3s}
.card:hover{transform:translateY(-4px);border-color:var(--o)}
.card svg{color:var(--o);font-size:max(18px,2cqw);flex:none;margin-top:.2cqw}
.card b{display:block;font-size:max(13px,1.4cqw);font-weight:600}
.card span{display:block;color:var(--g);font-size:max(11px,1.2cqw);line-height:1.35;margin-top:.5cqw}
.card::after{content:"";position:absolute;left:1.6cqw;bottom:1.1cqw;width:1.4cqw;height:2px;background:var(--o)}
.script{font-family:Caveat,cursive;color:var(--o);font-size:max(18px,2.1cqw);line-height:1.05;transform:rotate(-14deg);width:11cqw}
.pill{position:relative;overflow:hidden}.pill::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.4) 50%,transparent 70%);transform:translateX(-120%);transition:transform .7s;pointer-events:none}.pill:hover::after{transform:translateX(120%)}
em{font-style:italic}.pc .s,.story span,.card span{font-style:italic}
@keyframes up{from{opacity:0;transform:translateY(22px)}}
.txt>*{animation:up .9s cubic-bezier(.2,.7,.2,1) backwards}.txt>.h1,.txt>h1{animation-delay:.12s}.txt>.lead{animation-delay:.28s}.txt>.pill{animation-delay:.4s}.txt>.trust{animation-delay:.5s}
.why::before,.cat::before{content:"";display:block;height:1px;background:linear-gradient(90deg,transparent,rgba(255,122,10,.55),transparent)}
.cat{border-top:1px solid #1d1d1d;background:radial-gradient(50% 70% at 12% 0,rgba(255,110,0,.16),transparent 70%),#050505;padding:max(48px,6.4cqw) 0 max(40px,4.6cqw)}
.cat .hd{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:0 8cqw}
.cat h2{font-size:max(26px,3.1cqw);font-weight:700;border-left:2px solid var(--o);padding-left:.3cqw;line-height:1.1}
.cat .hd p{color:var(--g);font-size:max(13px,1.35cqw);margin-top:1cqw;max-width:40cqw;line-height:1.45}
.ctl{display:flex;gap:1cqw}
.ctl button{width:max(40px,4.2cqw);aspect-ratio:1;border:1px solid rgba(255,122,10,.6);border-radius:50%;display:grid;place-items:center;color:var(--o);font-size:max(16px,1.8cqw);transition:background .25s,color .25s}
.ctl button:hover{background:var(--o);color:#050505}.ctl .l svg{transform:scaleX(-1)}
.trk{position:relative;display:flex;gap:2cqw;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 8cqw;padding:max(24px,3.6cqw) 8cqw 1cqw;scrollbar-width:none}
.trk::-webkit-scrollbar{display:none}
.pc{flex:none;width:max(250px,26.5cqw);scroll-snap-align:start;display:flex;flex-direction:column;border:1px solid rgba(255,122,10,.35);border-radius:1.5cqw;background:linear-gradient(135deg,rgba(32,32,32,.78),rgba(8,8,8,.9));overflow:hidden;transition:transform .3s,border-color .3s}
.pc:hover{transform:translateY(-4px);border-color:var(--o)}
.pc figure{aspect-ratio:4/5;overflow:hidden;background:#111}
.pc img{height:100%;object-fit:cover;transition:transform .6s}.pc:hover img{transform:scale(1.04)}
.pc .b{padding:1.6cqw 1.8cqw 1.8cqw;display:flex;flex-direction:column;flex:1}
.pc h3{font-size:max(16px,1.8cqw);font-weight:600}
.pc .s{color:var(--o);font-size:max(12px,1.2cqw);margin-top:.3cqw}
.pc ul{list-style:none;margin:1.2cqw 0 1.6cqw;display:grid;gap:.7cqw;color:var(--g);font-size:max(12px,1.2cqw);line-height:1.4}
.pc li{display:flex;gap:.7em}.pc li svg{color:var(--o);flex:none;margin-top:.15em}
.pc .pill{margin-top:auto;font-size:max(13px,1.25cqw);padding:.9cqw 2cqw}
.dots{display:flex;justify-content:center;gap:.8cqw;margin-top:2.4cqw}
.dots button{width:max(18px,2.2cqw);height:3px;border-radius:2px;background:#333;transition:background .3s,width .3s;padding:8px 0;background-clip:content-box}
.dots button.on{background:var(--o);background-clip:content-box;width:max(30px,3.6cqw)}
.why{background:#080808;border-top:1px solid #1d1d1d}.why .pad{padding:6.4cqw 8cqw 3.6cqw}
.why h2{font-size:max(26px,3.1cqw);font-weight:700;border-left:2px solid var(--o);padding-left:.3cqw;line-height:1.1}
.grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:4.6cqw}
.grid>div{padding:0 2.2cqw;border-right:1px solid #232323}
.grid>div:first-child{padding-left:0}.grid>div:last-child{border:0}
.ring{width:max(48px,5.1cqw);aspect-ratio:1;border:2px solid var(--o);border-radius:50%;display:grid;place-items:center;font-size:max(22px,2.3cqw);color:var(--o);transition:background .3s,color .3s}
.grid>div:hover .ring{background:var(--o);color:#050505}
.grid h3{font-size:max(15px,1.75cqw);font-weight:600;margin:1.6cqw 0 .7cqw}
.grid p{font-size:max(13px,1.35cqw);line-height:1.45;color:var(--g)}
.rv{opacity:0;transform:translateY(18px);transition:opacity .6s,transform .6s}.rv.in{opacity:1;transform:none}
.grid>div:nth-child(2){transition-delay:.1s}.grid>div:nth-child(3){transition-delay:.2s}.grid>div:nth-child(4){transition-delay:.3s}
.sol{position:relative;background:radial-gradient(45% 90% at 30% 100%,rgba(255,110,0,.16),transparent 70%),#0a0a0a;overflow:hidden}.sol .in{position:relative;min-height:max(31.8cqw,340px)}
.sol .man{left:0;top:0;width:37.3cqw;mask-image:linear-gradient(90deg,#000 80%,transparent)}.sol .rock{right:0;top:0;width:24.6cqw;mask-image:linear-gradient(90deg,transparent,#000 24%),linear-gradient(180deg,#000 70%,transparent);mask-composite:intersect;-webkit-mask-composite:source-in}
.sol .t{left:38cqw;top:max(3.8cqw,28px);width:36cqw}
.sol small{font-size:max(12px,1.3cqw);font-weight:600;color:var(--o);display:block;letter-spacing:.08em}.sol small::before{content:"";display:inline-block;width:2.6cqw;min-width:22px;height:2px;background:var(--o);margin-right:.8cqw;vertical-align:middle}
.sol h2{font-size:max(26px,2.75cqw);font-weight:700;line-height:1.12;margin:.8cqw 0 1.4cqw}.sol h2 em{font-weight:500}
.sol p{font-size:max(14px,1.45cqw);line-height:1.55;width:100%;font-style:italic;color:#dcdcdc}
.sol .pill{font-size:max(13px,1.35cqw);padding:1.2cqw 2.4cqw;margin-top:2.6cqw}
.story{left:83.8cqw;top:19cqw;display:flex;align-items:center;gap:1.2cqw;font-size:max(12px,1.2cqw);line-height:1.3;color:#ddd;text-align:left}
.story i{width:max(40px,4cqw);aspect-ratio:1;border:1px solid var(--o);border-radius:50%;display:grid;place-items:center;color:var(--o);font-size:max(14px,1.6cqw);transition:background .3s,color .3s}
.story:hover i{background:var(--o);color:#000}
footer{padding:max(32px,4cqw) 6cqw calc(max(32px,4cqw) + env(safe-area-inset-bottom,0));text-align:center;border-top:1px solid #1d1d1d;background:#050505;color:var(--g);font-size:max(13px,1.3cqw)}
footer h3{color:#fff;font-size:max(18px,2cqw);font-weight:600;margin-bottom:1cqw}
footer .pill{font-size:max(13px,1.3cqw);padding:1cqw 2.4cqw;margin:1.6cqw 0}
dialog{margin:auto;border:1px solid rgba(255,122,10,.5);border-radius:18px;background:#0b0b0b;color:#fff;padding:28px;width:min(92vw,440px)}
dialog::backdrop{background:rgba(0,0,0,.75);backdrop-filter:blur(4px)}
dialog h3{font-size:22px;margin-bottom:6px}dialog p{color:var(--g);font-size:14px;line-height:1.5;margin-bottom:16px}
dialog label{display:block;font-size:12px;color:var(--g);margin:12px 0 5px}
dialog input,dialog select{width:100%;padding:12px 14px;border-radius:10px;border:1px solid #333;background:#141414;color:#fff;font:inherit;font-size:15px}
dialog input:focus,dialog select:focus,button:focus-visible,a:focus-visible{outline:2px solid var(--o);outline-offset:3px}
dialog .pill{width:100%;padding:14px;margin-top:20px;font-size:15px}
.x{position:absolute;top:12px;right:14px;font-size:22px;color:var(--g)}
@media(max-width:860px){
.cat .hd{padding:0 20px}.ctl{display:none}.cat .hd p{max-width:none}.trk{padding:24px 20px 4px;scroll-padding:0 20px;gap:14px}.pc{width:78vw}
.bg{display:block}nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;gap:0;margin:0;background:rgba(5,5,5,.96);padding:8px 24px 16px}
nav.open{display:flex}nav a{padding:12px 0;font-size:16px}nav a::after{display:none}
.bar{padding:0 20px}.rt .pill{display:none}.rt{gap:18px}
.hero{aspect-ratio:auto;padding:92px 20px 36px;display:flex;flex-direction:column;gap:22px}
.hero .a{position:static!important;width:auto!important}.txt{order:1}.head,.slash{display:none}
.hero .prod{order:2}.hero .c1{order:3}.hero .c2{order:4}.script{order:5;transform:rotate(-6deg)}
.lead{width:auto}.txt .pill{width:100%}.trust div{padding:0 14px}
.why .pad{padding:48px 20px 24px}.grid{grid-template-columns:1fr 1fr;gap:28px 0}.grid>div{padding:0 14px}.grid>div:nth-child(2n){border:0}.grid>div:nth-child(odd){padding-left:0}
.sol{padding-bottom:36px}.sol .in{min-height:0}.sol .man{position:static!important;width:100%;max-height:340px;object-fit:cover;object-position:top;mask-image:linear-gradient(180deg,#000 70%,transparent)}.sol .rock{display:none}
.sol .t{position:static!important;width:auto!important;padding:24px 20px 0}.sol p{width:auto}
.story{position:static!important;margin:24px 20px 0}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}.rv{opacity:1;transform:none}}

/* OHMAN - section videos */
.ohman-videos {
  width: 100%;
  padding: 70px 6%;
  background: #0A0A0C;
  color: #FFFFFF;
  box-sizing: border-box;
}
.ohman-videos-heading {
  text-align: center;
  margin: 0 auto 32px;
}
.ohman-videos-heading small {
  color: #D4AF37;
  letter-spacing: 3px;
  font-weight: 700;
}
.ohman-videos-heading h2 {
  font-size: clamp(24px, 4vw, 38px);
  margin: 14px 0;
}
.ohman-videos-heading p {
  color: #B8B8B8;
  line-height: 1.6;
}
.ohman-videos-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
  max-width: 1100px;
  margin: 0 auto;
}
.ohman-video-card {
  overflow: hidden;
  border: 1px solid rgba(212, 175, 55, 0.35);
  border-radius: 14px;
  background: #16161A;
}
.ohman-video-card video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}
@media (max-width: 600px) {
  .ohman-videos {
    padding: 45px 5%;
  }
  .ohman-videos-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }
}
/* OHMAN PREMIUM VIDEO EFFECTS */
.ohman-video-card {
  position: relative;
  isolation: isolate;
  border: 1px solid rgba(212, 175, 55, 0.42);
  border-radius: 16px;
  background: #101012;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.28);
  transition:
    transform 350ms ease,
    border-color 350ms ease,
    box-shadow 350ms ease;
}

.ohman-video-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(
    135deg,
    rgba(244, 229, 178, 0.12),
    transparent 35%,
    transparent 70%,
    rgba(184, 134, 11, 0.08)
  );
  opacity: 0.65;
  transition: opacity 350ms ease;
}

.ohman-video-card video {
  position: relative;
  z-index: 0;
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  background: #080809;
  transition: filter 350ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .ohman-video-card:hover {
    transform: translateY(-5px);
    border-color: rgba(244, 229, 178, 0.9);
    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.45),
      0 0 24px rgba(212, 175, 55, 0.10);
  }

  .ohman-video-card:hover::after {
    opacity: 1;
  }

  .ohman-video-card:hover video {
    filter: contrast(1.03) saturate(1.04);
  }
}

.ohman-video-card:focus-within {
  outline: 2px solid rgba(212, 175, 55, 0.75);
  outline-offset: 4px;
}

@media (max-width: 600px) {
  .ohman-video-card {
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .ohman-video-card:hover {
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ohman-video-card,
  .ohman-video-card::after,
  .ohman-video-card video {
    transition: none;
  }
}
