  document.querySelectorAll('.ohman-offre-fixe').forEach(function(n){n.classList.remove('ohman-offre-fixe');});

  /* 2. Repérer l'ancien cadre du compte à rebours */
  var cd=document.getElementById('ohman-countdown');
  var hH=document.getElementById('ohman-hour'),hM=document.getElementById('ohman-min'),hS=document.getElementById('ohman-sec');
  if(!cd||!hH||!hM||!hS)return;
  var box=null,e=cd;
  while(e&&e!==document.body&&e!==document.documentElement){
    var p=getComputedStyle(e).position;
    if(p==='fixed'||p==='sticky'){box=e;break;}
    e=e.parentElement;
  }
  (box||cd).classList.add('ohman-orig-offer');

  /* 3. Créer la barre du bas et la synchroniser */
  if(document.getElementById('ohman-offer-bar'))return;
  var bar=document.createElement('div');
  bar.id='ohman-offer-bar';
  bar.setAttribute('aria-hidden','true');
  bar.innerHTML='<span class="t">OFFRE SPÉCIALE</span><span class="d"><b id="ob-h">24</b><i>:</i><b id="ob-m">00</b><i>:</i><b id="ob-s">00</b></span>';
  document.body.appendChild(bar);
  var oh=bar.querySelector('#ob-h'),om=bar.querySelector('#ob-m'),os=bar.querySelector('#ob-s');
  function sync(){oh.textContent=hH.textContent;om.textContent=hM.textContent;os.textContent=hS.textContent;}
